# === PostgreSQL ===
POSTGRES_DB=emailfilter
POSTGRES_USER=emailfilter_user
POSTGRES_PASSWORD=changeme_in_prod
POSTGRES_HOST=postgres
POSTGRES_PORT=5432

# === JWT ===
JWT_SECRET=change-this-to-a-256-bit-secret-key-in-production
JWT_EXPIRATION_MS=86400000
JWT_REFRESH_EXPIRATION_MS=604800000

# Clave para cifrar en reposo los tokens OAuth (AES-GCM). Cualquier longitud.
# Si falta, los tokens se guardan en texto plano (solo para desarrollo).
TOKEN_ENCRYPTION_KEY=change-this-to-a-long-random-string-in-production

# === Email Sync ===
# Max emails to fetch per sync run (first sync and incremental). Default 1000.
EMAIL_SYNC_MAX_EMAILS=1000
# Pausa (ms) entre cada descarga de mensaje en Gmail, para respetar la cuota
# por usuario (totalQueryCostPerMinutePerUser=6000). Default 250.
EMAIL_SYNC_REQUEST_DELAY_MS=250
# Hilos para descargar detalles en paralelo en el full sync. Solo solapa latencia
# de red: la tasa la fija EMAIL_SYNC_REQUEST_DELAY_MS (espaciado global). Default 6.
EMAIL_SYNC_FETCH_CONCURRENCY=6

# === Contacts ===
# Días de enviados que se leen la primera vez que se arma la lista de contactos
# frecuentes (solo Gmail; Outlook queda con los recibidos). Default 365.
CONTACTS_SENT_WINDOW_DAYS=365
# Tope de mails enviados en ese barrido. Cada uno cuesta ~20 unidades de cuota. Default 2000.
CONTACTS_SENT_MAX=2000

# === Google OAuth2 ===
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3001/auth/callback

# === Outlook OAuth2 ===
OUTLOOK_CLIENT_ID=your-outlook-client-id
OUTLOOK_CLIENT_SECRET=your-outlook-client-secret
OUTLOOK_REDIRECT_URI=http://localhost:3001/auth/callback
OUTLOOK_TENANT=common

# === AI Service ===
AI_SERVICE_URL=http://ai-python:8000
AI_PROVIDER=openai
AI_API_KEY=your-groq-api-key
AI_API_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b  # Verified working Groq model (llama-3.1-8b-instant returns 404)
# Shared secret between backend and ai-python (header X-Internal-Token). Empty = every AI route returns 503.
AI_INTERNAL_TOKEN=

# === Frontend ===
FRONTEND_URL=http://localhost:3001

# === Producción (docker-compose.prod.yml) ===
# Dominio público que apunta a la VM (ej. tuapp.duckdns.org). Caddy pide el certificado HTTPS para él.
DOMAIN=localhost
